{
 "version": 2,
 "kind": "kerb-contacts",
 "raceId": "fuji_aim_2020_07_30",
 "trackId": "fuji",
 "definition": "Kerb-contact labels from the logger internal IMU: roll-rate high-pass (>~3 Hz) RMS over 0.2 s; events = RMS > 1.0 deg/s merged across < 0.3 s gaps. Each event is attributed to one kerb by the CG station at its RMS peak (inside-kerb pass first; kerb = null when no kerb zone is within 3 m). One label per inside-kerb pass: strong = an event attributed to it has peak >= 1.5, silent = pass peak <= 0.8, otherwise mild. GPS-independent apart from locating the pass/peak.",
 "strengthBins": [
  {
   "id": "low",
   "label": "弱",
   "minPeak": 1.0,
   "maxPeak": 1.5
  },
  {
   "id": "mid",
   "label": "中",
   "minPeak": 1.5,
   "maxPeak": 3.0
  },
  {
   "id": "high",
   "label": "強",
   "minPeak": 3.0,
   "maxPeak": null
  }
 ],
 "peakUnit": "deg/s (roll-rate high-pass RMS, 0.2 s window)",
 "sideAttribution": "not published: the 4-wheel ECU speed-ripple ratio is confounded with the corner direction (0.82 in right-handers, 1.31 in left-handers without kerb contact, 7/30); an inside-kerb label is read as \"the inner wheels hit\", never as a measured side",
 "timeBase": {
  "basis": "lap t (s) of the shipped lap JSON = GPS time base = viewer playback clock (0 = first GPS sample of the lap)",
  "loggerToGps": "t = (logger_ms - tc0Ms) / 1000 + shiftSeconds",
  "shiftSecondsByLap": {
   "1": 0.497,
   "2": 0.523,
   "3": 0.523,
   "4": 0.555,
   "5": 0.565,
   "6": 0.583
  },
